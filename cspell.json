{
	"language": "en-GB",
	"ignorePaths": [
		"**/node_modules/**",
		"LICENSE",
		"**/coverage/**",
		"**/dist/**",
		"**/docs/reference/**",
		"**/docs/open-api/**",
		"**/tests/**",
		"*.yaml",
		"package.json",
		"vitest.config.*",
		"tsconfig.json",
		"tsconfig.eslint.json",
		"typedoc.json",
		"eslint.config*",
		"**/wordlists/**",
		"changelog.md"
	],
	"words": [
		"abbrev",
		"autorelease",
		"bech",
		"cryptosuite",
		"DARP",
		"eddsa",
		"Faucet",
		"ipfs",
		"jsonld",
		"lteq",
		"nameof",
		"ODRL",
		"PNAP",
		"PNRP",
		"openapi",
		"Stiftung",
		"Unece",
		"Unrevoke"
	],
	"ignoreRegExpList": [
		"/from\\s+(['\"]).*\\1/",
		"/eslint-disable.*/",
		"/^```shell[\\s\\S]*?```$/gm",
		"/^```json[\\s\\S]*?```$/gm",
		"/tst1.*/",
		"/^```(.|\\s)*?```\\s*$/gm",
		"eyJraWQ.*"
	]
}
