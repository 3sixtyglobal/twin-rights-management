{
	"$comment": "PAP (Policy Administration Point) - Stored Agreement with ODRL duty clause. Shows notification permission with clearing house notification obligation.",
	"@context": [
		"http://www.w3.org/ns/odrl.jsonld",
		{
			"twin": "https://w3id.org/twin/odrl/"
		}
	],
	"@type": "Agreement",
	"uid": "http://example.com/policy-service-offering:vet-cert-notification",
	"assigner": "did:iota:testnet:0xfcfa55894cab90504af7eaf38087addd5f77791a89bd3ebbe76d9c2b1a6ce567",
	"description": "Permit veterinary certificate notifications to UK authority when certification and destination constraints are satisfied",
	"permission": [
		{
			"action": "permission",
			"target": {
				"@type": "ServiceOffering",
				"uid": "https://twin.example.org/service-offerings/vet-cert-notification"
			},
			"assignee": {
				"@type": "PartyCollection",
				"refinement": {
					"leftOperand": "twin:jsonPath",
					"twin:jsonPathExpression": ".certifications",
					"operator": "contains",
					"rightOperand": "FSA-Trusted-Notifier"
				}
			},
			"constraint": [
				{
					"leftOperand": "twin:jsonPath",
					"twin:jsonPathExpression": ".resource.destinationCountry.countryId",
					"operator": "eq",
					"rightOperand": "GB",
					"comment": "Only consignments destined for Great Britain qualify"
				}
			],
			"duty": [
				{
					"action": {
						"@type": "Action",
						"rdf:value": "notify"
					},
					"target": "https://my-ds-connectors.example.org/ds-connector-uk-fsa/notify",
					"constraint": [
						{
							"leftOperand": "twin:jsonPath",
							"twin:jsonPathExpression": ".payload.documentTypeCode",
							"operator": "eq",
							"rightOperand": "unece:DocumentCodeList#853",
							"comment": "Notify only for veterinary certificate documents"
						}
					]
				}
			]
		}
	],
	"papMetadata": {
		"storedAt": "2025-09-15T08:00:00Z",
		"status": "active",
		"version": "1.0",
		"createdBy": "notification-admin",
		"lastModified": "2025-09-15T08:00:00Z",
		"indexedFields": {
			"assigner": "did:iota:testnet:0xfcfa55894cab90504af7eaf38087addd5f77791a89bd3ebbe76d9c2b1a6ce567",
			"action": "permission",
			"targetType": "ServiceOffering",
			"targetUid": "https://twin.example.org/service-offerings/vet-cert-notification",
			"assigneeType": "PartyCollection",
			"hasDutyClause": true,
			"dutyAction": "notify"
		},
		"policyLocatorHints": {
			"lookupKey": "assigner:did:iota:testnet:0xfcfa55894cab90504af7eaf38087addd5f77791a89bd3ebbe76d9c2b1a6ce567:action:permission:target:service-offering",
			"searchableConstraints": ["certifications", "destinationCountry", "documentTypeCode"],
			"requiresFederatedCatalogue": true,
			"obligationTracking": "duty-notify-clearing-house"
		}
	}
}
