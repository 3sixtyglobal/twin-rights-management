{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/rights-management/PolicyNegotiationRequest",
	"description": "The JSON-LD definition for the policy negotiation proof.",
	"type": "object",
	"properties": {
		"assignee": {
			"type": "string",
			"description": "The assignee for the locator."
		},
		"action": {
			"type": "string",
			"description": "The action for the locator."
		},
		"assetType": {
			"type": "string",
			"description": "The asset type for the locator."
		},
		"resourceId": {
			"type": "string",
			"description": "A resource identifier for the locator."
		},
		"@context": {
			"type": "string",
			"const": "https://schema.twindev.org/rights-management",
			"description": "The JSON-LD context."
		},
		"type": {
			"type": "string",
			"const": "PolicyNegotiationRequest",
			"description": "The type of the proof."
		},
		"information": {
			"$ref": "https://schema.twindev.org/rights-management/PolicyInformation",
			"description": "Additional information provided by the requester to determine if a policy can be created."
		}
	},
	"required": [
		"@context",
		"type"
	],
	"additionalProperties": false
}
