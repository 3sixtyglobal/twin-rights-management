{
	"name": "@twin.org/rights-management-pep-service",
	"version": "0.9.2-next.0",
	"description": "Policy enforcement point service for applying decisions to protected data flows.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iotaledger/twin-rights-management.git",
		"directory": "packages/rights-management-pep-service"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build:compile": "tspc",
		"build": "npm run build:compile",
		"dev": "nodemon --watch src --ext ts --exec \"npm run build\"",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "npm run docs:clean && npm run docs:generate",
		"dist": "npm run clean && npm run build && npm run validate-locales && npm run test:build && npm run test",
		"dist:no-test": "npm run clean && npm run build && npm run test:build"
	},
	"dependencies": {
		"@twin.org/core": "next",
		"@twin.org/rights-management-models": "0.9.2-next.0",
		"@twin.org/logging-models": "next",
		"@twin.org/nameof": "next",
		"@twin.org/data-json-ld": "next",
		"@twin.org/standards-w3c-odrl": "next"
	},
	"devDependencies": {
		"@twin.org/entity-storage-connector-memory": "next",
		"@twin.org/logging-connector-entity-storage": "next",
		"@twin.org/logging-service": "next",
		"@twin.org/nameof-transformer": "next",
		"@twin.org/nameof-vitest-plugin": "next",
		"@twin.org/validate-locales": "next",
		"@twin.org/rights-management-pap-service": "0.9.2-next.0",
		"@twin.org/rights-management-pdp-service": "0.9.2-next.0",
		"@twin.org/rights-management-pip-service": "0.9.2-next.0",
		"@twin.org/rights-management-pmp-service": "0.9.2-next.0",
		"@twin.org/rights-management-pxp-service": "0.9.2-next.0",
		"@types/node": "26.1.1",
		"@vitest/coverage-v8": "4.1.10",
		"copyfiles": "2.4.1",
		"dotenv": "17.4.2",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"ts-patch": "4.0.1",
		"typedoc": "0.28.20",
		"typedoc-plugin-markdown": "4.12.0",
		"typescript": "6.0.3",
		"vitest": "4.1.10"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		},
		"./locales/*.json": "./locales/*.json"
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"rights-management",
		"service",
		"microservice",
		"business-logic"
	],
	"bugs": {
		"url": "git+https://github.com/iotaledger/twin-rights-management/issues"
	},
	"homepage": "https://twindev.org"
}
